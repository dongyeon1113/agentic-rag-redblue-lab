APP_VERSION=0.1.0
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=5
HOST_BIND=127.0.0.1
ORCHESTRATOR_PORT=8000
LOCAL_DB_PORT=8001
GMAIL_PORT=8002
DRIVE_PORT=8003
OLLAMA_PORT=11434
OLLAMA_IMAGE=ollama/ollama@sha256:6345fbc18bd73a1e16404be681dbc6fd291a027cab43ed541abe78c4c81051b0
# Used only with compose.remote-ollama.yaml. Prefer a private VPC or VPN IP;
# never expose an unauthenticated Ollama port to the public internet.
# REMOTE_OLLAMA_BASE_URL=http://100.64.0.10:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ANSWER_MODELS=qwen3:8b,llama3.2:3b,llama3.2:1b
# Copy this file to .env and put your Hugging Face token after the equals sign.
# Never commit the real token.
HF_TOKEN=
PROMPT_GUARD_MODEL=meta-llama/Prompt-Guard-86M
PROMPT_GUARD_DEVICE=cuda
PROMPT_GUARD_THRESHOLD=0.95
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=256
# Semantic planner; leave ROUTER_MODEL empty to reuse the selected answer model
# and avoid model swapping in CPU-only deployments.
LLM_ROUTER_ENABLED=true
ROUTER_MODEL=
ROUTER_NUM_PREDICT=512
MOCK_CONNECTED_EMAIL_RECIPIENT=user@example.test
RAG_CONTEXT_LIMIT=6
MEMORY_RECALL_LIMIT=3
RAGPART_ENABLED=false
RAGPART_FRAGMENTS=5
RAGPART_COMBINATION_SIZE=3
# Full 2.68M-document BEIR NQ corpus (built via scripts/build_nq_corpus.py
# --count 2681468). Not in git (~1.6GB); deploy it out-of-band and point
# this at the host path, then bump CHROMA_COLLECTION to a new name so
# local-db-agent indexes into a fresh collection instead of blocking its
# health check for hours re-indexing the live one. Defaults to the
# git-tracked 100k corpus when unset.
# AGENT_POISON_CORPUS_HOST_FILE=./datasets/generated/nq_2681468.json
# CHROMA_COLLECTION=local-db-nomic-v2
DRIVE_SYNC_ENABLED=false
DRIVE_DATA_FILE=/app/data/google_drive_documents.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GMAIL_SYNC_ENABLED=false
GMAIL_DATA_FILE=/app/data/google_gmail_messages.json
GMAIL_QUERY=in:anywhere
GMAIL_MAX_MESSAGES=100
GOOGLE_GMAIL_OAUTH_CLIENT_FILE=./secrets/google-gmail-oauth-client.json
GOOGLE_GMAIL_TOKEN_FILE=./secrets/google-gmail-token.json
