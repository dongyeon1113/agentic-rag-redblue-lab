FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ANONYMIZED_TELEMETRY=False

WORKDIR /app

COPY pyproject.toml requirements-complete.txt README.md ./
COPY src ./src
COPY mock_data ./mock_data

RUN python -m pip install --no-cache-dir . \
    && python -m pip install --no-cache-dir -r requirements-complete.txt

RUN addgroup --system app \
    && adduser --system --ingroup app app \
    && mkdir -p /app/data/local_db /app/data/gmail /app/data/drive /app/data/orchestrator \
    && chown -R app:app /app

USER app

CMD ["uvicorn", "agent_system.api.agent:app", "--host", "0.0.0.0", "--port", "8000"]

